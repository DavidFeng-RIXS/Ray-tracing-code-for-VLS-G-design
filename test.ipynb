    "# calculator.ipynb\n",
    "def calculate(x):\n",
    "    return x ** 2 + 3 * x + 2\n",
    "\n",
    "# 示例：用户输入一个数字，返回计算结果\n",
    "number = float(input(\"Enter a number: \"))\n",
    "result = calculate(number)\n",
    "print(f\"Result: {result}\")"
   ]
  }
